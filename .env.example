# ============================================================
# 発注インフォマート 認証情報
# このファイルを .env にコピーして実際の値を設定してください
# .env は絶対にGitにコミットしないでください
# ============================================================

# インフォマート ログイン情報
INFOMART_USER_ID=B9sFJEYM
INFOMART_PASSWORD=KLG4yin3
# Google API 認証情報ファイルパス
# Google Cloud Console でサービスアカウントを作成し、JSONをダウンロードしてください
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service_account.json

# (オプション) 既存スプレッドシートを指定する場合
# 未設定の場合は自動作成
GOOGLE_SPREADSHEET_ID=

# (オプション) Google Drive の親フォルダID
# 未設定の場合は「棚卸自動化/インフォマート」フォルダを自動作成
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# ログレベル: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
