# ============================================================
# hansoku 環境変数テンプレート
#   本番（GitHub Actions）では、この内容を GitHub Secrets に登録する。
#   ローカル開発では .env にコピーして使う（.env はコミットしない）。
#   何も設定しなければ全レイヤーがローカル実装で動くため、
#   認証情報が揃う前でも開発・テストができる。
# ============================================================

# --- 実行モード -------------------------------------------------
# local = 認証情報なし（DuckDB / ローカルPostgres / ローカルFS）
# cloud = BigQuery / Neon / Cloudflare R2
HANSOKU_ENV=local

# --- Warehouse（実績データ f_actuals）---------------------------
# cloud のとき必須。GCPプロジェクトは既存 infomart-automation-498709 を流用する。
BIGQUERY_PROJECT=infomart-automation-498709
BIGQUERY_DATASET=hansoku
# サービスアカウント鍵。GitHub Secrets には JSON の中身をそのまま入れる。
GOOGLE_SERVICE_ACCOUNT_JSON=

# local のときの DuckDB ファイル置き場
LOCAL_WAREHOUSE_PATH=.local/warehouse.duckdb

# --- App DB（施策・目標・マスタ・集計結果）----------------------
# cloud のとき必須。Neon の接続文字列。
NEON_DATABASE_URL=
# local のときの接続先（ローカルPostgres）
LOCAL_DATABASE_URL=postgresql://postgres@127.0.0.1:5433/hansoku

# --- Object Storage（制作物PDF）--------------------------------
# cloud のとき必須。Cloudflare R2（S3互換）。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hansoku-creatives
# 公開URLの先頭（R2のパブリック開発URL または 独自ドメイン）
R2_PUBLIC_BASE_URL=
# local のときのファイル置き場
LOCAL_OBJECT_STORE_PATH=.local/objects

# --- 既存FW共有シート（実績の取り込み元。読み取り専用）-----------
# 既存パイプライン（infomart_automation / foodist_journal.py）が書き込んでいるシート。
# このシステムは読むだけで、既存パイプラインには一切書き込まない。
FW_SPREADSHEET_ID=18Fq_mpEweHOFTlF4ntmwJzDsJNSt-DOq7wQYy8E0iLc

# --- Web Push（Phase 3 で使用）---------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:amami@8sin.co.jp
